# ---------------------------------------------------------------------------
# Sandbox Grand Prix — copy to .env and fill in. .env is gitignored.
# Any provider whose keys are missing is skipped and marked DNS (did not start).
# ---------------------------------------------------------------------------

# E2B — https://e2b.dev/dashboard?tab=keys
E2B_API_KEY=

# Modal — https://modal.com/settings/tokens  (or run: modal token new)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Daytona — https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
# Optional overrides
# DAYTONA_API_URL=
# DAYTONA_TARGET=
